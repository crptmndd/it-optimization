# Скопировать в server/.env и заполнить. В репозиторий .env не коммитится.

# --- База -------------------------------------------------------------------
# Локально поднимается docker compose (см. server/docker-compose.yml).
DATABASE_URL=postgresql://itopt:itopt@localhost:5433/itopt?schema=public

# --- Сервис -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Кому разрешён доступ к API (CORS + куки): сайт и CRM, через запятую.
# В проде: https://it-optimization.ru,https://crm.it-optimization.ru
WEB_ORIGIN=http://localhost:3000,http://localhost:5173

# Secure-флаг на сессионной куке. В проде обязательно true (нужен HTTPS).
COOKIE_SECURE=false
# Домен куки. В проде — .it-optimization.ru, если API живёт на поддомене.
COOKIE_DOMAIN=
# Срок жизни сессии в днях.
SESSION_TTL_DAYS=14

# --- Пароли и двухфакторный вход --------------------------------------------
# Ключ, которым сервер шифрует пароли из «Доступов» и секреты 2FA: 32 байта в base64.
# Сгенерировать один раз:  openssl rand -base64 32
# Пусто — API работает, но пароли и 2FA недоступны.
# Потеря ключа — потеря паролей: заменить его нельзя, копию держать вне сервера.
VAULT_KEY=
# Адрес CRM: только с него открываются пароли. Пусто — проверки нет, так работает
# локальный запуск. В проде: https://crm.it-optimization.ru
CRM_ORIGIN=

# --- Файлы ------------------------------------------------------------------
# Куда складываются обработанные картинки кейсов.
UPLOAD_DIR=./uploads
# Максимальный размер загружаемого файла, байты (по умолчанию 15 МБ).
MAX_UPLOAD_BYTES=15728640

# --- Напоминания в телеграме ------------------------------------------------
# Токен от @BotFather. Не задан — бот не запускается, всё остальное работает.
# В репозиторий не коммитится: .env закрыт gitignore.
TELEGRAM_BOT_TOKEN=
# Общий чат (у групп id отрицательный, с -100): утренняя сводка, задачи с тэгами
# исполнителей, счета за месяц, блокировки входа, новые лиды.
# Пусто — лиды уходят лично всем, кто подключил бота, а всё остальное молчит.
TELEGRAM_TEAM_CHAT_ID=
# Адрес Bot API. Менять, только если до api.telegram.org нет прямого хода —
# некоторые хостеры режут именно его. Тогда сюда прописывается ретранслятор.
TELEGRAM_API_BASE=https://api.telegram.org
# Во сколько уходит утренний список, ЧЧ:ММ.
DIGEST_TIME=09:00
# Вечерние личные напоминания: что открыто на сегодня и что на завтра.
REMINDER_TIME=17:00
# Пояс, в котором считаются «сегодня» и «просрочено».
TIMEZONE=Europe/Moscow

# --- Задачи из сообщений боту ----------------------------------------------
# Боту можно написать, переслать или наговорить «Фиксы по кошельку Камилю» — он
# заведёт задачу в CRM. Разбор делает открытая модель на Replicate, голос —
# Whisper там же. Токен: replicate.com → Account → API tokens. Пусто — бот
# работает как раньше. Около $0.001 за задачу, голосовое — ещё ~$0.005.
REPLICATE_API_TOKEN=
# Модели разбора через запятую: снятую с Replicate бот пропустит и возьмёт
# следующую (и напишет об этом в журнал). Подойдёт любая официальная языковая
# модель с полями prompt и max_tokens. Пусто — модель из кода (Kimi K2.6).
REPLICATE_LLM_MODEL=moonshotai/kimi-k2.6
# Запасная расшифровка голосовых, если openai/whisper не ответил
# (версия vaibhavs10/incredibly-fast-whisper). Пусто — без неё; не задано — из кода.
# REPLICATE_WHISPER_FALLBACK_VERSION=

# --- Публикация -------------------------------------------------------------
# Публикация коммитит снапшот content/cases.json и картинки в репозиторий,
# GitHub Actions пересобирает статику и заливает её на хостинг.
# Без этих переменных публикация работает в «сухом» режиме: снапшот отдаётся,
# но никуда не уезжает — удобно для локальной разработки.
GITHUB_TOKEN=
GITHUB_OWNER=crptmndd
GITHUB_REPO=it-optimization
GITHUB_BRANCH=main
