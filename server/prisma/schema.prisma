// Схема базы сайта it-optimization.ru. См. docs/backend.md.
// Форма таблицы `cases` намеренно совпадает с content/cases.json, поэтому
// перенос данных — это сид, а не переделка модели.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Портфолио

enum ContentStatus {
  draft
  published
}

model Case {
  id     String        @id @default(uuid()) @db.Uuid
  /// Участвует в именах файлов и в ссылках со страниц услуг, поэтому живёт
  /// отдельно от id и переживает переименование заголовка.
  slug   String        @unique
  status ContentStatus @default(published)

  title       String
  description String
  quote       String
  /// Раньше было одной строкой «A · B · C»; массив — нормальная форма.
  tags        String[]
  /// Ключи услуг (SERVICE_PAGES), на страницах которых показывается кейс и
  /// по которым он фильтруется. Кейс может относиться к нескольким сразу.
  services    String[]

  /// Порядок на сайте. Первые HOME_CASE_COUNT попадают на главную.
  position Int

  assets  CaseAsset[]
  /// Проект, из которого вырос кейс. Заполняется, когда закрытый проект
  /// публикуют на сайте; у кейсов, заведённых руками, связи нет.
  project Project?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Мягкое удаление: кейс исчезает с сайта, но остаётся для истории.
  deletedAt DateTime? @map("deleted_at")

  @@index([status, position])
  @@map("cases")
}

enum AssetSlot {
  cover
  detail
  detail_mobile
}

/// Картинки кейса. Отдельной таблицей: ассет переживает смену slug, а по хэшу
/// видно, что перезаливать его не нужно.
model CaseAsset {
  id     String    @id @default(uuid()) @db.Uuid
  caseId String    @map("case_id") @db.Uuid
  case   Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  slot   AssetSlot

  /// Публичный путь внутри сайта, например /cases/case-crm-a1b2c3d4.webp
  path   String
  /// Хэш содержимого — он же в имени файла, чтобы замена обходила кеш браузера.
  hash   String
  width  Int
  height Int
  bytes  Int

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([caseId, slot])
  @@map("case_assets")
}

// -------------------------------------------------------------------- Блог

/// Статья блога. Форма совпадает с content/blog.json ровно так же, как у
/// кейсов: панель редактирует статью здесь, публикация кладёт снапшот в
/// репозиторий, сайт остаётся статикой.
model Post {
  id     String        @id @default(uuid()) @db.Uuid
  /// Адрес /blog/<slug>/ и часть имени файла обложки. После публикации не
  /// меняется: адрес статьи уже в выдаче и в чужих ссылках.
  slug   String        @unique
  status ContentStatus @default(published)

  title           String
  /// Описание для карточки в списке блога.
  excerpt         String
  /// Рубрика: плашка на обложке и третий уровень хлебных крошек.
  category        String
  /// Вводный абзац под заголовком.
  lead            String
  metaTitle       String @map("meta_title")
  metaDescription String @map("meta_description")

  /// Публичный путь обложки: /blog/post-<slug>-<hash>.webp либо рисованный
  /// SVG первых статей. Отдельной таблицы, как у кейсов, нет — картинка одна.
  cover       String @default("")
  /// Время чтения в минутах. Панель считает по объёму, но значение правится.
  readingTime Int    @map("reading_time")

  /// Разделы статьи: [{ heading, body: string[] }]. JSON, а не две таблицы:
  /// разделы никогда не читаются отдельно от статьи, не ищутся и не
  /// переиспользуются — это её тело, а не связанные сущности.
  sections  Json
  /// Блок «Коротко» в конце. Может быть пустым.
  takeaways String[]
  /// Ключи услуг (SERVICE_PAGES), о которых статья. Связь двусторонняя: внизу
  /// статьи из них собирается блок услуг, а на странице услуги — блок статей.
  services  String[]

  /// Порядок в блоге. Обычно новые сверху, но это решает редактор.
  position Int

  /// Дата публикации (день, без времени) — показывается в карточке и уезжает
  /// в Article-разметку.
  publishedAt DateTime @map("published_at") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Мягкое удаление: статья исчезает с сайта, но остаётся для истории.
  deletedAt DateTime? @map("deleted_at")

  @@index([status, position])
  @@map("posts")
}

/// Счётчик ревизий контента — основа оптимистичной блокировки. Панель
/// открывается на version = value и присылает её обратно; если значение
/// успело измениться, запись отклоняется.
// ------------------------------------------------------------- Каталог услуг

/// Раздел каталога услуг. Не маршрут, а кнопка фильтра на /uslugi/ — поэтому у
/// него нет ни адреса, ни текстов, только подпись и порядок. Форма совпадает с
/// `content/service-catalog.json`, так что перенос — это сид, а не переделка.
model ServiceCategory {
  key      String @id
  title    String
  position Int

  services ServiceEntry[]

  @@map("service_categories")
}

/// Услуга в каталоге: адрес страницы, раздел и признак черновика.
///
/// Тексты страницы сюда не переезжают — они остаются в `content/services.json`.
/// Здесь только структура, которую правит панель: к какому разделу услуга
/// относится, в каком порядке стоит и опубликована ли.
///
/// `key` — первичный ключ, а не uuid: на него ссылаются статьи блога, кейсы,
/// 3D-сцены героя и `Lead.service` в CRM, и он должен совпадать в пяти местах.
model ServiceEntry {
  key         String  @id
  slug        String  @unique
  categoryKey String  @map("category_key")
  /// Черновик собирается и открывается по своему адресу, но не попадает ни в
  /// каталог, ни в меню, ни в карту сайта, а страница отдаётся с noindex.
  draft       Boolean @default(false)
  position    Int

  /// Restrict, а не Cascade: удаление раздела не должно уносить с собой
  /// страницы услуг, которые в нём стояли.
  category ServiceCategory @relation(fields: [categoryKey], references: [key], onDelete: Restrict)

  @@map("service_entries")
}

model ContentRevision {
  id        Int      @id @default(autoincrement())
  scope     String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_revisions")
}

// ------------------------------------------------------------------- Доступ

/// Две роли. Ограничение проверяется на каждом маршруте, а не прячется в меню:
/// скрытая кнопка защищает от случайности, а не от человека с консолью.
///
/// Значения в базе прежние (`owner`, `editor`): DDL enum не менялся, поэтому откат
/// API на старый образ работает без SQL. В сыром SQL писать старые значения.
enum UserRole {
  /// Видит всё: команду, деньги, доступы, панель сайта.
  admin     @map("owner")
  /// Видит только своё: см. `src/crm/access.ts`.
  employee  @map("editor")
  /// Устарело, строк нет. Осталось только потому, что Postgres не умеет удалять
  /// значение enum.
  marketing
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  /// Argon2id. Открытый пароль не хранится и не логируется.
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(employee)
  lastLoginAt  DateTime? @map("last_login_at")

  /// Чат, который бот считает этой учёткой: там работает `/today`, а без общего чата
  /// туда же уходят новые лиды. Пусто — нормальное состояние, подключение добровольное.
  telegramChatId        String?   @unique @map("telegram_chat_id")
  /// Одноразовый код привязки: CRM показывает его вошедшему пользователю, тот
  /// отправляет боту `/start <код>`. Так бот узнаёт, кто ему пишет, не спрашивая
  /// ни почту, ни пароль — в переписке с ботом им не место.
  telegramLinkCode      String?   @unique @map("telegram_link_code")
  telegramLinkExpiresAt DateTime? @map("telegram_link_expires_at")

  /// Секрет TOTP, зашифрованный VAULT_KEY (см. crypto/sealed.ts). Заполнен, но
  /// totpEnabledAt пуст — подключение начато и код ещё не подтверждён.
  totpSecretEnc      String?   @map("totp_secret_enc")
  /// Признак включённой 2FA. Отдельно от секрета: вход не должен требовать код
  /// от человека, который только открыл экран настройки.
  totpEnabledAt      DateTime? @map("totp_enabled_at")
  /// Номер 30-секундного шага последнего принятого кода. Запрещает повтор кода
  /// внутри окна ±1: без него подсмотренный код живёт полторы минуты.
  totpLastStep       Int?      @map("totp_last_step")
  /// Счётчик неверных кодов подряд. Лимит по адресу не спасает от перебора с
  /// разных адресов, поэтому держим ещё и лимит на человека. Считает и коды при
  /// подключении: там пятая ошибка стирает незавершённый секрет.
  totpFailedAttempts Int       @default(0) @map("totp_failed_attempts")
  totpLockedUntil    DateTime? @map("totp_locked_until")
  /// Когда начато подключение. Незавершённый секрет живёт недолго: брошенное
  /// подключение не должно оставлять украденной куке, что подбирать без пароля.
  totpSetupAt        DateTime? @map("totp_setup_at")

  sessions      Session[]
  pins          CredentialPin[]
  actions       AuditLog[]
  recoveryCodes RecoveryCode[]
  loginTickets  LoginTicket[]
  /// Человек из команды, которым значится эта учётка. Есть не у каждой.
  member        TeamMember?

  ownedLeads   Lead[]           @relation("LeadOwner")
  createdTasks Task[]           @relation("TaskAuthor")
  attachments  TaskAttachment[] @relation("AttachmentAuthor")
  notes        Note[]           @relation("NoteAuthor")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  disabledAt DateTime? @map("disabled_at")

  @@map("users")
}

/// Серверные сессии вместо JWT: в cookie уходит только случайный секрет, в базе
/// лежит его хэш — так доступ отзывается мгновенно.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  /// До какого момента эта сессия открывает пароли без повторного кода.
  twoFactorConfirmedUntil DateTime? @map("two_factor_confirmed_until")

  @@index([userId])
  @@map("sessions")
}

/// Билет между паролем и кодом. В базе, как и сессии: хранится только хэш, а
/// перезапуск API не выбрасывает человека посреди входа.
model LoginTicket {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("login_tickets")
}

/// Одноразовые коды восстановления. SHA-256 хватает: в коде 16 случайных символов,
/// перебирать по дампу нечего.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

/// Люди команды: кто может значиться исполнителем проекта или задачи.
///
/// Ключ — имя: оно и лежит в `developers[]`. Исполнители значатся именами, а не
/// учётками, потому что учётка есть не у каждого, а её отключение не должно стирать
/// человека из истории. Связь с учёткой отдельная и необязательная; SetNull, потому
/// что люди из `developers[]` переживают удаление учётки.
model TeamMember {
  name             String   @id
  telegramUsername String?  @map("telegram_username")
  userId           String?  @unique @map("user_id") @db.Uuid
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("team_members")
}

/// Файл к задаче: скриншот бага, документ или голосовое от клиента. Чаще всего приходит
/// из телеграма вместе с поручением. Сам файл лежит на диске в UPLOAD_DIR/attachments,
/// под случайным именем: исходное бывает каким угодно, и в путь его пускать нельзя.
/// Отдаётся только через API тем, кому видна задача: в нём бывают данные клиентов.
model TaskAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Имя для человека: под ним файл и скачивается.
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  size        Int
  /// Имя на диске. Уникально, поэтому запись и файл однозначно находят друг друга.
  storageKey  String   @unique @map("storage_key")
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("AttachmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_attachments")
}

/// Сообщение бота автору задачи «выполнено, проверьте». Хранится, чтобы перерисовать его, когда
/// задачу вернут в работу, проверят или отменят: иначе у админа висела бы кнопка
/// «Проверено» под задачей, которая уже снова в работе. В базе, а не в памяти: проверка
/// ждёт часами, а перезапуск API при выкате стёр бы всё, что ждёт.
model TaskReviewMessage {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  chatId    String   @map("chat_id")
  messageId Int      @map("message_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([chatId, messageId])
  @@index([taskId])
  @@map("task_review_messages")
}

/// Кто, что и когда изменил.
model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity   String
  entityId String? @map("entity_id")
  action   String
  diff     Json?
  ip       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------- CRM
//
// Внутренняя система команды: лиды, клиенты, проекты, задачи. Живёт в той же
// базе, что и контент сайта, — пользователи, сессии и журнал общие, бэкап
// один. Публичных страниц не касается: сайт остаётся статикой и о таблицах
// ниже не знает.

enum LeadStatus {
  /// Пришёл, никто ещё не взял в работу.
  new
  /// Ответили, идёт переписка.
  contacted
  /// Понятно, что нужно; считаем или готовим предложение.
  qualified
  /// Превратился в проект.
  won
  /// Отказ — свой или клиента.
  lost
}

/// Обращения. Пока заводятся руками: заявки идут в мессенджеры мимо сайта.
/// Поля `source` и `channel` рассчитаны на будущую форму — когда она появится,
/// добавится только маршрут, миграция не потребуется.
model Lead {
  id String @id @default(uuid()) @db.Uuid

  name    String?
  /// Как с ним связаться: телефон, почта или ник. Одной строкой — на входе
  /// это всегда одна строка, и разбирать её всё равно никто не станет.
  contact String
  message String?
  /// Страница входа и utm-метки. Заполняет форма; при ручном заведении пусто.
  source  Json?
  /// Откуда пришёл: form | telegram | whatsapp | max | phone | email | referral.
  /// Строка, а не enum: список каналов меняется чаще, чем стоит гонять миграции.
  channel String?

  status LeadStatus @default(new)

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Когда следующий шаг. Просроченное значение — единственная причина, по
  /// которой лид попадает в утренний дайджест: статусы сами о себе не
  /// напоминают, и «ведём переписку» висит месяцами, пока про него не забудут.
  nextActionAt   DateTime? @map("next_action_at")
  /// Что именно за шаг: «позвонить», «отправить смету». Без него напоминание
  /// сообщает только срок, и всё равно приходится открывать карточку, чтобы
  /// вспомнить, о чём речь.
  nextActionNote String?   @map("next_action_note")
  lostReason     String?   @map("lost_reason")

  /// Ключ услуги из SERVICE_PAGES сайта — что человеку нужно. Отвечает на
  /// вопрос «какие услуги вообще приносят обращения». Строка, а не enum:
  /// список услуг живёт на сайте и меняется без участия базы.
  service String?

  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projects Project[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, nextActionAt])
  @@index([createdAt])
  @@map("leads")
}

model Client {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  /// Единственный реквизит, который стоит держать отдельным полем: по нему
  /// клиент однозначно опознаётся в документах и в банке.
  inn      String?
  site     String?
  /// [{ type: "phone" | "email" | "telegram", value, label? }] — список, а не
  /// колонки: у одного клиента бывает три телефона и ни одной почты.
  contacts Json?
  notes    String?

  leads    Lead[]
  projects Project[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("clients")
}

enum ProjectStatus {
  planned
  active
  /// Ждём клиента, оплату или сторонний сервис. Отдельно от active, потому что
  /// зависший проект и идущий проект требуют разного внимания.
  on_hold
  done
  cancelled
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      ProjectStatus @default(planned)
  /// Колонка доски. Статус берётся из её типа, см. `BoardColumn`. Пусто — первая колонка
  /// типа: так проект не теряется, если колонку удалили между чтением и записью.
  columnId    String?       @map("column_id") @db.Uuid
  column      BoardColumn?  @relation(fields: [columnId], references: [id], onDelete: SetNull)

  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Из какого обращения вырос. Нужен, чтобы был виден весь путь от первого
  /// сообщения до сданной работы.
  leadId   String? @map("lead_id") @db.Uuid
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// Кто ведёт. Имена, а не ссылки на учётные записи: исполнитель — человек из
  /// команды, и своя учётка у него есть не всегда, а отключение учётки не должно
  /// стирать его из истории проектов. Список — проект нередко тянут вдвоём, и в
  /// утренней сводке должно быть видно обоих.
  ///
  /// Допустимые значения проверяются по таблице `team_members` (см. src/crm/people.ts):
  /// свободная строка означала бы «Вадим», «вадим» и «Вадик» как трёх разных
  /// людей, и любая группировка по имени сразу бы врала.
  developers String[]

  /// Где размещён: «наш VPS», «reg.ru у клиента», «Timeweb». Свободная строка —
  /// хостингов столько же, сколько клиентов, и списком их не закрыть.
  hosting  String?
  /// Вид работы: договорной, разовый, сопровождение. Строкой, а не enum: набор
  /// уточняется по ходу, а миграция ради нового варианта — перебор.
  workType String? @map("work_type")

  contractNumber String?   @map("contract_number")
  contractDate   DateTime? @map("contract_date")
  /// Дата акта по проекту в целом. Не вводится и API больше не отдаётся: акты
  /// живут записями в invoices. Колонка оставлена, чтобы откат API ничего не
  /// терял и старые значения можно было прочитать из базы.
  actDate        DateTime? @map("act_date")

  /// Счета выставляются каждый месяц. Признак нужен, чтобы бот напоминал про
  /// период, за который счёта ещё нет, — в этом и весь смысл учёта.
  billingMonthly     Boolean  @default(false) @map("billing_monthly")
  /// Ожидаемая сумма в месяц — в минорных единицах: копейках или центах.
  ///
  /// Целое, а не дробное: 0.1 + 0.2 в двоичной дроби не равно 0.3, и на суммах
  /// это однажды вылезает расхождением в копейку. Decimal решил бы то же, но
  /// притащил бы отдельный тип на все слои, включая JSON.
  ///
  /// Суффикс в имени не для красоты: без него пропущенное при правке место
  /// покажет сумму в сто раз больше и никак об этом не скажет.
  monthlyAmountMinor Int?     @map("monthly_amount_minor")
  /// Валюта monthlyAmount и счетов проекта по умолчанию.
  currency           Currency @default(rub)

  invoices    Invoice[]
  credentials Credential[]
  stages      ProjectStage[]

  /// Порядок внутри колонки на доске.
  position Int @default(0)

  startedAt    DateTime? @map("started_at")
  deadline     DateTime?
  closedAt     DateTime? @map("closed_at")
  /// Архив — отдельный признак, а не статус: проект в архиве сохраняет итог
  /// («сдан», «отменён»), а статус говорит о работе, не о том, видно ли его.
  archivedAt   DateTime? @map("archived_at")
  /// Месяц ГГГГ-ММ, с которого считается «Не выставлено» у старого сопровождения
  /// без галочки, ставшего подходящим без единой записи. Без него первой записью
  /// станет следующий месяц, и этот пропадёт из списка молча. Ставит и снимает
  /// rememberUnbilledMonth() в projects/monthly-documents.ts.
  unbilledFrom String?   @map("unbilled_from")

  /// Кейс на сайте, в который превратился проект. Связь ставится в момент
  /// публикации; удаление кейса обнуляет её, но не трогает сам проект.
  caseId String? @unique @map("case_id") @db.Uuid
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  tasks Task[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, deadline])
  @@index([columnId, position])
  @@index([archivedAt])
  @@map("projects")
}

/// Этап договорного проекта. Отдельная таблица, а не строки invoices: два этапа
/// могут прийтись на один месяц и упёрлись бы в уникальность счёта за период, а
/// порядок оплаты нельзя было бы обойти через маршруты счетов. Подробнее — в
/// CLAUDE.md. Порядок оплаты проверяет сервер: projects/stages.ts.
///
/// Общая сумма договора не хранится: это сумма этапов, а второе хранимое число
/// однажды разошлось бы с первым. Валюта у каждого этапа своя: у проекта она
/// может смениться, а уже оплаченная сумма менять смысл не должна.
model ProjectStage {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 1, 2 или 3. Границы держит CHECK в миграции: Prisma их не описывает.
  position    Int       @db.SmallInt
  /// В минорных единицах. Пусто — сумму ещё не назвали.
  amountMinor Int?      @map("amount_minor")
  currency    Currency  @default(rub)
  issuedAt    DateTime? @map("issued_at")
  paidAt      DateTime? @map("paid_at")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([projectId, position])
  @@map("project_stages")
}

/**
 * Валюта суммы. Хранится рядом с каждой суммой, а не одна на всю систему:
 * часть работ считается в долларах, и общий признак заставлял бы переводить
 * по курсу — то есть придумывать число, которого никто не называл.
 * По той же причине суммы в разных валютах нигде не складываются: итоги
 * считаются отдельно по каждой.
 */
enum Currency {
  rub
  usd
}

enum InvoiceKind {
  /// Счёт на оплату.
  invoice
  /// Акт выполненных работ.
  act
}

/// Счета и акты по проекту, по одному на период.
///
/// Отдельная запись, а не поле проекта: счета выставляются каждый месяц, и
/// «дата счёта» одним полем затирала бы прошлый месяц. Здесь же видно, за
/// какой период выставлено, что оплачено и чего ещё нет.
///
/// Документы CRM не рисует — только помнит. Генерация требует нумерации,
/// реквизитов и НДС, а болит не она: болит «за апрель выставить забыли».
model Invoice {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      InvoiceKind

  /// Период в виде ГГГГ-ММ. Строкой, потому что это календарный месяц, а не
  /// момент времени: сравнивать и сортировать так же просто, а часовые пояса
  /// не превращают март в февраль.
  period      String
  /// В минорных единицах, как и monthlyAmountMinor у проекта. Валюта — рядом.
  amountMinor Int?     @map("amount_minor")
  currency    Currency @default(rub)

  issuedAt DateTime? @map("issued_at")
  paidAt   DateTime? @map("paid_at")
  note     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Один счёт и один акт на период: два счёта за март — это ошибка ввода.
  @@unique([projectId, kind, period])
  @@index([period])
  @@map("invoices")
}

/// Колонки досок задач и проектов. Название и порядок задаёт админ, `kind` — статус,
/// который получают карточки колонки (`server/src/crm/columns/columns.ts`). Тип не
/// меняется после создания, последнюю колонку типа удалить нельзя.
model BoardColumn {
  id        String    @id @default(uuid()) @db.Uuid
  /// "task" | "project"
  scope     String
  title     String
  /// Статус задачи или проекта: todo, in_progress, done / planned, active, on_hold, done, cancelled.
  kind      String
  position  Int
  tasks     Task[]
  projects  Project[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([scope, position])
  @@map("board_columns")
}

enum TaskStatus {
  backlog
  todo
  in_progress
  done
  cancelled
}

/// Порядок значений значим: `orderBy priority desc` в «Сегодня» идёт по нему, а не по
/// алфавиту. `high` значит «Срочно»: значение старше четырёх уровней, и его не трогали,
/// поэтому уже срочные задачи, старая вкладка CRM и откат API обходятся без переписывания
/// строк. «Высокая» — это `important`, она встала перед ним.
enum TaskPriority {
  low
  normal
  important
  high
}

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String?

  /// Необязателен намеренно: половина настоящих задач ни к какому проекту не
  /// относится — «продлить домен», «выставить счёт», «ответить в налоговую».
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Родитель подзадачи. Вложенность в один уровень держит API, а не база. Cascade
  /// срабатывает только при физическом удалении: мягкое подзадачи не трогает.
  parentId String? @map("parent_id") @db.Uuid
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  status     TaskStatus   @default(todo)
  priority   TaskPriority @default(normal)
  /// Колонка доски, статус берётся из её типа. У подзадач и отменённых пусто: на доске их нет.
  columnId   String?      @map("column_id") @db.Uuid
  /// Убрана в архив руками (админом). Закрытые старше трёх дней в архиве и без этого,
  /// см. `archivedTaskWhere`. Смена статуса или колонки отметку снимает.
  archivedAt DateTime?    @map("archived_at")
  column     BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  /// Порядок внутри колонки на доске.
  position   Int          @default(0)

  /// Кто делает. Имена из `team_members`, как и у проекта, — по той же причине.
  developers  String[]
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("TaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  attachments    TaskAttachment[]
  /// Сообщения админам «на проверку», см. `TaskReviewMessage`.
  reviewMessages TaskReviewMessage[]

  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, position])
  @@index([columnId, position])
  @@index([dueAt])
  @@index([parentId])
  @@map("tasks")
}

/// Учётки сервисов, которыми пользуется команда: что у нас есть, на кого
/// записано, на какой почте, когда продлевать и под каким паролем заходят.
///
/// Открытых паролей в базе нет: она регулярно уезжает в дампы, и одна утечка
/// отдала бы разом все сервисы. Пароль лежит в `passwordEnc`, зашифрованный
/// ключом VAULT_KEY из окружения сервера, а смотреть его можно только через
/// POST /credentials/:id/reveal, с кодом 2FA и записью в журнал.
model Credential {
  id               String    @id @default(uuid()) @db.Uuid
  /// Название сервиса: reg.ru, Яндекс 360, GitHub.
  service          String
  /// Логин или адрес почты, под которым заходят.
  login            String?
  url              String?
  /// На кого оформлено — имя человека из команды или название компании.
  owner            String?
  /// К какому проекту относится доступ. Пусто — общий: почта, GitHub, хостинг.
  ///
  /// SetNull, а не Cascade: закрытый проект не должен уносить с собой пароль от
  /// хостинга, на котором его сайт продолжает работать.
  projectId        String?   @map("project_id") @db.Uuid
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Бывшее поле «Где пароль». Из формы и API убрано, текст миграция дописала в
  /// `notes`. Колонка оставлена: откат API должен находить её на месте.
  secretHint       String?   @map("secret_hint")
  /// Старый пароль, зашифрованный в браузере мастер-фразой: base64 от
  /// `iv || ciphertext`. Заморожен: новые пароли идут в `passwordEnc`, а этот
  /// читается только при разовом переносе и не очищается, потому что он запас на
  /// случай отката API. Что с ним уже решено, говорит `secretMigratedAt`.
  secret           String?   @db.Text
  /// Пароль, зашифрованный на сервере AES-256-GCM ключом VAULT_KEY. Наружу не
  /// отдаётся никогда, кроме POST /credentials/:id/reveal.
  passwordEnc      String?   @map("password_enc") @db.Text
  /// Когда судьба старого `secret` решена: перенесён или заменён новым паролем.
  /// Без отметки стёртый пароль вернулся бы при следующем переносе, потому что
  /// `secret` намеренно не очищается.
  secretMigratedAt DateTime? @map("secret_migrated_at")
  /// Когда продлевать: домены, сертификаты, платные подписки.
  renewsAt         DateTime? @map("renews_at")
  /// Сколько стоит, в минорных единицах — как у проекта.
  amountMinor      Int?      @map("amount_minor")
  currency         Currency  @default(rub)
  /// Списывается каждый месяц. Без признака сумма непонятна: 500 ₽ у хостинга
  /// и 500 ₽ у домена — это про разные деньги в год.
  monthlyFee       Boolean   @default(false) @map("monthly_fee")
  notes            String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  pins CredentialPin[]

  @@index([service])
  @@index([projectId])
  @@map("credentials")
}

/// Закреплённая запись в Доступах. Отдельная таблица, а не поле записи: набор у каждого
/// админа свой. Время нужно для порядка в группе: новая отметка встаёт в конец и не
/// сдвигает то, что человек уже помнит по месту.
model CredentialPin {
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String     @map("credential_id") @db.Uuid
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([userId, credentialId])
  @@index([credentialId])
  @@map("credential_pins")
}

/// Отметки планировщика: «эта рассылка за такое-то число уже ушла».
///
/// Именно в базе, а не в памяти процесса: иначе перезапуск сервиса днём решит,
/// что дайджеста сегодня ещё не было, и разошлёт его повторно — а при пяти
/// перезапусках пять раз. Дата хранится строкой ГГГГ-ММ-ДД в часовом поясе
/// команды: сравнивать надо календарные сутки, а не моменты времени.
/// Параметры хранилища паролей. Строка ровно одна: ключ у команды общий.
model VaultSetting {
  id String @id @default("vault")

  /// Соль для вывода ключа из мастер-фразы. Не секрет, но менять её нельзя —
  /// с другой солью тот же пароль даёт другой ключ, и всё станет нечитаемым.
  salt     String
  /// Контрольное значение, зашифрованное тем же ключом. Расшифровалось —
  /// фраза верна. Иначе проверить правильность ввода нечем: сервер не знает
  /// ни фразы, ни ключа.
  verifier String

  createdAt DateTime @default(now()) @map("created_at")

  @@map("vault_settings")
}

model JobRun {
  job   String   @id
  ranOn String   @map("ran_on")
  ranAt DateTime @updatedAt @map("ran_at")

  @@map("job_runs")
}

/// Комментарии сразу ко всему: лид, клиент, проект, задача. Одна таблица
/// вместо четырёх — на троих отдельные comment-таблицы дают лишние джойны и
/// ноль пользы. Внешнего ключа нет намеренно: он не бывает полиморфным.
model Note {
  id       String @id @default(uuid()) @db.Uuid
  /// lead | client | project | task
  entity   String
  entityId String @map("entity_id") @db.Uuid
  body     String

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entity, entityId, createdAt])
  @@map("notes")
}
